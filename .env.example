# Shopify Admin API (from Dev Dashboard > Tracking Assistant > Settings > Credentials)
SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com
SHOPIFY_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_CLIENT_SECRET=shpss_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_API_VERSION=2024-01

# dianxiaomi.com requires a captcha at login, so there's no username/password
# here. Instead, run `python setup_dianxiaomi_session.py` once to log in by
# hand; it saves a session file (dianxiaomi_state.json) that the app reuses.

# Set to false to watch the browser while tuning selectors against the real site
PLAYWRIGHT_HEADLESS=true
